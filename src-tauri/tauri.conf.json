{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Git Assistant",
  "version": "0.6.2",
  "identifier": "nz.co.allaneramo.ai-git-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Git Assistant",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Allan P. Erasmo",
    "externalBin": ["binaries/ai-git-sidecar"]
  }
}
